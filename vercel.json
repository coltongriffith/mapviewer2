{
  "functions": {
    "api/claims.js": {
      "maxDuration": 60
    },
    "api/bc-claims.js": {
      "maxDuration": 60
    },
    "api/tenure-search.js": {
      "maxDuration": 30
    }
  },
  "rewrites": [
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/map/:id",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/account/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/tenure-monitor",
      "destination": "/index.html"
    },
    {
      "source": "/tenure-monitor/:path*",
      "destination": "/index.html"
    }
  ],
  "headers": [
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://www.googletagmanager.com https://googleads.g.doubleclick.net; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https://*.basemaps.cartocdn.com https://server.arcgisonline.com https://*.tile.opentopomap.org https://*.tiles.openrailwaymap.org https://tile.openstreetmap.org https://www.googletagmanager.com https://www.google.com https://googleads.g.doubleclick.net; connect-src 'self' https://*.supabase.co wss://*.supabase.co https://va.vercel-scripts.com https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://googleads.g.doubleclick.net https://td.doubleclick.net https://ad.doubleclick.net; object-src 'none'; frame-ancestors 'none';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    }
  ],
  "redirects": [
    {
      "source": "/blog/mining-claims-map-british-columbia{/}?",
      "destination": "/bc-mineral-claims-map/",
      "permanent": true
    },
    {
      "source": "/blog/mining-claims-map-ontario{/}?",
      "destination": "/blog/how-to-search-ontario-mining-claims/",
      "permanent": true
    },
    {
      "source": "/blog/mining-claims-map-quebec{/}?",
      "destination": "/blog/how-to-search-quebec-mining-claims/",
      "permanent": true
    },
    {
      "source": "/blog/mining-claims-map-saskatchewan{/}?",
      "destination": "/blog/how-to-search-saskatchewan-mineral-claims/",
      "permanent": true
    },
    {
      "source": "/blog/mining-claims-map-manitoba{/}?",
      "destination": "/blog/how-to-search-manitoba-mining-claims/",
      "permanent": true
    },
    {
      "source": "/blog/mining-claims-map-newfoundland-labrador{/}?",
      "destination": "/blog/how-to-search-newfoundland-mineral-claims/",
      "permanent": true
    },
    {
      "source": "/blog/mining-claims-map-yukon{/}?",
      "destination": "/blog/how-to-search-yukon-quartz-claims/",
      "permanent": true
    },
    {
      "source": "/blog/how-to-choose-basemap-mining-map{/}?",
      "destination": "/blog/how-to-make-a-professional-exploration-map/",
      "permanent": true
    },
    {
      "source": "/blog/how-to-export-mining-map-pdf{/}?",
      "destination": "/blog/how-to-make-a-professional-exploration-map/",
      "permanent": true
    },
    {
      "source": "/blog/how-to-add-distance-ring-mining-map{/}?",
      "destination": "/blog/how-to-make-a-professional-exploration-map/",
      "permanent": true
    },
    {
      "source": "/blog/how-to-add-scale-bar-north-arrow{/}?",
      "destination": "/blog/how-to-make-a-professional-exploration-map/",
      "permanent": true
    },
    {
      "source": "/blog/what-to-include-on-a-mining-claim-map{/}?",
      "destination": "/blog/how-to-make-a-mining-claims-map/",
      "permanent": true
    },
    {
      "source": "/blog/map-drill-results-for-junior-mining-news-release{/}?",
      "destination": "/blog/how-to-make-a-drill-results-map/",
      "permanent": true
    },
    {
      "source": "/blog/locations{/}?",
      "destination": "/blog/",
      "permanent": true
    },
    {
      "source": "/mining-exploration-map-software{/}?",
      "destination": "/mining-map-software/",
      "permanent": true
    },
    {
      "source": "/blog/mineral-exploration-map-for-investor-deck{/}?",
      "destination": "/blog/how-to-create-exploration-map-investor-presentation/",
      "permanent": true
    },
    {
      "source": "/blog/turn-public-mineral-claim-data-into-project-map{/}?",
