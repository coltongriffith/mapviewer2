{
  "functions": {
    "api/claims.js": {
      "maxDuration": 60
    },
    "api/bc-claims.js": {
      "maxDuration": 60
    },
    "api/tenure-search.js": {
      "maxDuration": 30
    },
    "api/agent.js": {
      "maxDuration": 60
    },
    "api/mcp.js": {
      "maxDuration": 60
    }
  },
  "rewrites": [
    {
      "source": "/mcp/server",
      "destination": "/api/mcp"
    },
    {
      "source": "/mcp/account",
      "destination": "/api/mcp?auth=account"
    },
    {
      "source": "/.well-known/oauth-protected-resource",
      "destination": "/api/mcp?wellknown=protected-resource"
    },
    {
      "source": "/.well-known/oauth-protected-resource/:path*",
      "destination": "/api/mcp?wellknown=protected-resource"
    },
    {
      "source": "/api/agent/v1/preview",
      "destination": "/api/agent?action=preview"
    },
    {
      "source": "/api/agent/v1/capabilities",
      "destination": "/api/agent?action=capabilities"
    },
    {
      "source": "/api/agent/v1/keys",
      "destination": "/api/agent?action=keys"
    },
    {
      "source": "/api/agent/v1/maps",
      "destination": "/api/agent?action=maps"
    },
    {
      "source": "/api/agent/openapi.json",
      "destination": "/agent/openapi.json"
    },
    {
      "source": "/",
      "destination": "/index.html"
    },
    {
      "source": "/map/:id",
      "destination": "/index.html"
    },
    {
      "source": "/admin",
      "destination": "/index.html"
    },
    {
      "source": "/admin/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard",
      "destination": "/index.html"
    },
    {
      "source": "/dashboard/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/account",
      "destination": "/index.html"
    },
    {
      "source": "/account/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/tenure-monitor",
      "destination": "/index.html"
    },
    {
      "source": "/tenure-monitor/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/workspace",
      "destination": "/index.html"
    },
    {
      "source": "/workspace/:path*",
      "destination": "/index.html"
    },
    {
      "source": "/invite",
      "destination": "/index.html"
    },
    {
      "source": "/oauth/consent",
      "destination": "/index.html"
    },
    {
      "source": "/3d",
      "destination": "/3d/index.html"
    },
    {
      "source": "/3D",
      "destination": "/3d/index.html"
    },
    {
      "source": "/3d/share/:id",
      "destination": "/3d/index.html"
    },
    {
      "source": "/3d/embed/:id",
      "destination": "/3d/index.html"
    },
    {
      "source": "/teams",
      "destination": "/teams/index.html"
    }
  ],
  "headers": [
    {
      "source": "/((?!3d/embed/[^/]+/?$).*)",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://analytics.ahrefs.com https://www.googletagmanager.com https://googleads.g.doubleclick.net https://www.googleadservices.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://analytics.ahrefs.com https://fonts.googleapis.com https://fonts.gstatic.com https://*.supabase.co wss://*.supabase.co https://va.vercel-scripts.com https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://googleads.g.doubleclick.net https://td.doubleclick.net https://ad.doubleclick.net https://www.googleadservices.com; frame-src 'self' https://td.doubleclick.net https://www.googletagmanager.com; object-src 'none'; frame-ancestors 'none';"
        },
        {
          "key": "X-Frame-Options",
          "value": "DENY"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/3d/embed/:id",
      "headers": [
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' https://analytics.ahrefs.com https://www.googletagmanager.com https://googleads.g.doubleclick.net https://www.googleadservices.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: blob: https:; connect-src 'self' https://analytics.ahrefs.com https://fonts.googleapis.com https://fonts.gstatic.com https://*.supabase.co wss://*.supabase.co https://va.vercel-scripts.com https://www.googletagmanager.com https://www.google-analytics.com https://www.google.com https://googleads.g.doubleclick.net https://td.doubleclick.net https://ad.doubleclick.net https://www.googleadservices.com; frame-src 'self' https://td.doubleclick.net https://www.googletagmanager.com; object-src 'none'; frame-ancestors *;"
        },
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Strict-Transport-Security",
          "value": "max-age=31536000; includeSubDomains"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), interest-cohort=()"
        }
      ]
    },
    {
      "source": "/3d/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/3D",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-cache"
        }
      ]
    },
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/.well-known/openai-apps-challenge",
      "headers": [
        {
          "key": "Content-Type",
          "value": "text/plain; charset=utf-8"
        }
      ]
    },
    {
      "source": "/admin/",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/admin/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/dashboard/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/account/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/tenure-monitor/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/workspace/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/invite/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/map/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/3d/embed/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/3d/share/:id",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    },
    {
      "source": "/api/:path*",
      "headers": [
        {
          "key": "X-Robots-Tag",
          "value": "noindex, follow"
        }
      ]
    }
  ],
