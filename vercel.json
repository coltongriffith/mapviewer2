      "permanent": true
    },
    {
      "source": "/blog/drill-results-map-:region{/}?",
      "destination": "/blog/how-to-make-a-drill-results-map/",
      "permanent": true
    },
    {
      "source": "/blog/mining-claims-map-:region{/}?",
      "destination": "/blog/how-to-make-a-mining-claims-map/",
      "permanent": true
    },
    {
      "source": "/blog/location-map-:region{/}?",
      "destination": "/blog/how-to-create-exploration-map-investor-presentation/",
      "permanent": true
    },
    {
      "source": "/blog/target-generation-map-:region{/}?",
      "destination": "/blog/how-to-create-target-generation-map/",
      "permanent": true
    },
    {
      "source": "/blog/infrastructure-map-:region{/}?",
      "destination": "/blog/how-to-create-infrastructure-map/",
      "permanent": true
    }
  ]
}
